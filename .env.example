# Browser-safe settings. Real AI is the default; mock is explicit for offline tests.
VITE_AI_MODE=http
VITE_AI_ENDPOINT=/api/ai/analyze
# Used only by the optional deterministic mock provider.
VITE_MOCK_DELAY_MS=120
# Server-only origin from the supplied Postman collection. No key is needed by this app.
# This service is plain HTTP: configure HTTPS before sending sensitive schema/questions.
AI_STACK_BASE_URL=http://72.62.135.252:8080
# Production Node server; defaults to localhost. Deploy behind HTTPS and access controls.
HOST=127.0.0.1
PORT=3000
